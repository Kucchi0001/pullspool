# ============================================================================
# PullSpool release deployment
#
# 1. cp .env.release.example .env
# 2. 修改 PUBLIC_IP / TLS_HOST / PUBLIC_BASE_URL 为你的 VPS 地址
# 3. docker compose -f docker-compose.release.yml pull
# 4. docker compose -f docker-compose.release.yml up -d
#
# 使用前确认 4 个 GHCR Package 已发布；private 包需要先 docker login ghcr.io。
# 镜像名必须小写：ghcr.io/kucchi0001（不是 Kucchi0001）。
# ============================================================================

COMPOSE_PROJECT_NAME=pullspool

# 数据目录（数据库、下载文件、aria2 session、Caddy 证书）
HOST_DATA_DIR=./data

# 容器运行用户；VPS 上执行 id -u / id -g 填入，并确保 data 属主一致：
#   sudo chown -R 1000:1000 ./data
PULLSPOOL_UID=1000
PULLSPOOL_GID=1000

# GHCR 镜像前缀与版本；tag 要和 git tag 一致
PULLSPOOL_GHCR_NAMESPACE=ghcr.io/kucchi0001
PULLSPOOL_GHCR_TAG=v1.0.0

# 时区（影响日志和“今日流量”的日界）
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai

# ----------------------------------------------------------------------------
# 对外访问
# ----------------------------------------------------------------------------
HTTP_ENABLED=true
HTTPS_ENABLED=true
HTTP_PORT=18080
HTTPS_PORT=18443
BIND_ADDRESS=0.0.0.0

# internal = 自签 CA；acme = Let's Encrypt（需要域名、80/443）
TLS_MODE=internal
DOMAIN=
ACME_EMAIL=

# 必须改：VPS 的公网 IP / 域名
PUBLIC_IP=203.0.113.5
TLS_HOST=203.0.113.5
PUBLIC_BASE_URL=https://203.0.113.5:18443

# ----------------------------------------------------------------------------
# 首次管理员（首次登录后强制改密；bootstrap 文件随后删除）
# ----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------------
# 可选：留空则启动时自动生成
# ----------------------------------------------------------------------------
ARIA2_RPC_SECRET=
DOWNLOAD_TOKEN_SECRET=
