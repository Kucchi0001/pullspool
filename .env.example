# ============================================================================
# PullSpool 环境配置
# 使用：cp .env.example .env && chmod 600 .env，按需修改后 docker compose up -d
# 最快：sudo sh scripts/quickstart.sh（自动生成 .env、填公网 IP、preflight、启动）
# 修改端口/TLS 后只需 docker compose up -d 重新创建容器。
# ============================================================================

# 数据目录（数据库、下载文件、aria2 session、Caddy 证书）
HOST_DATA_DIR=./data

# 仅使用预构建镜像时（docker-compose.release.yml 或 quickstart --ghcr）填写：
# PULLSPOOL_GHCR_NAMESPACE=ghcr.io/your-github-name
# PULLSPOOL_GHCR_TAG=latest
# 容器运行用户 UID/GID。VPS 上执行 `id -u` / `id -g` 填入，并确保 data 目录属主一致：
#   sudo chown -R 1000:1000 ./data
PULLSPOOL_UID=1000
PULLSPOOL_GID=1000
# 影响日志时间与"今日流量"的日界（IANA 时区名）
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------------------
# 对外访问（只有 caddy 发布端口）
# ---------------------------------------------------------------------------
HTTP_ENABLED=true
HTTPS_ENABLED=true
HTTP_PORT=18080
HTTPS_PORT=18443
# 监听地址；只允许本机访问可改成 127.0.0.1（配合 SSH 隧道）
BIND_ADDRESS=0.0.0.0

# TLS 模式：
#   off      仅 HTTP（密码明文过网，仅限 SSH 隧道/内网）
#   internal Caddy 内置 CA 为 TLS_HOST 签发证书（只有 IP 时用这个）
#   acme     Let's Encrypt 为 DOMAIN 自动签发（需要 80/443 可达）
TLS_MODE=internal

# VPS 公网 IP（TLS_MODE=internal 必填；用于证书与界面展示）
PUBLIC_IP=203.0.113.5
# 证书主机名：internal 模式填 IP 或域名；留空则回退到 PUBLIC_IP
TLS_HOST=203.0.113.5

# 有域名时：DOMAIN=pull.example.com 且 TLS_MODE=acme
DOMAIN=
ACME_EMAIL=

# 对外完整地址（用于 Caddy 的 Origin 校验与下载链接拼接）
# internal: https://203.0.113.5:18443   acme: https://pull.example.com
PUBLIC_BASE_URL=https://203.0.113.5:18443

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=text
BOOTSTRAP_ADMIN_USERNAME=admin
# 初始管理员密码。默认 admin，首次登录强制修改。
# 如果 VPS 会直接暴露公网，建议在首次启动前改成一个随机密码：
#   openssl rand -base64 24
BOOTSTRAP_ADMIN_PASSWORD=admin
# 全站 API 每 IP 每分钟请求上限（登录/建任务/发令牌另有更严格限制）
API_RATE_LIMIT_PER_MINUTE=300

# 初始化与自检节奏（一般不需要改）
TASK_POLL_INTERVAL_SECONDS=1
SCHEDULER_INTERVAL_SECONDS=1
CLEANUP_INTERVAL_SECONDS=600
ARIA2_TIMEOUT_SECONDS=5
ARIA2_SAVE_SESSION_INTERVAL=30

# ---------------------------------------------------------------------------
# 下载引擎
# ---------------------------------------------------------------------------
# 内部端口，不发布到宿主机
ARIA2_RPC_PORT=6800
# RPC 密钥；留空则 aria2 启动时自动生成到 ${HOST_DATA_DIR}/aria2/secret
ARIA2_RPC_SECRET=
# 出站防火墙：阻断 aria2 访问内网/元数据地址（推荐保持 on）
ARIA2_EGRESS_GUARD=on

# 下载令牌签名密钥；留空则首次启动自动生成到 ${HOST_DATA_DIR}/.token_secret
DOWNLOAD_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# 构建参数（中国大陆网络建议使用镜像源；官方源可留空）
# ---------------------------------------------------------------------------
PIP_INDEX_URL=
NPM_REGISTRY=https://registry.npmjs.org

# Caddy 镜像（一般不需要改）
CADDY_IMAGE=caddy:2-alpine

# ---------------------------------------------------------------------------
# 容器资源上限（适配 1 vCPU / 1 GB 的低配 VPS，可按机型调整）
# ---------------------------------------------------------------------------
BACKEND_MEM_LIMIT=320m
BACKEND_CPU_LIMIT=1.0
ARIA2_MEM_LIMIT=256m
ARIA2_CPU_LIMIT=1.0
FRONTEND_MEM_LIMIT=64m
FRONTEND_CPU_LIMIT=0.5
CADDY_MEM_LIMIT=96m
CADDY_CPU_LIMIT=0.5
